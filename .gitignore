# ESP-IDF build artifacts
build/
build-tests/
sdkconfig
sdkconfig.old
dependencies.lock

# Managed components (downloaded by idf.py)
managed_components/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.cache/

# Local API credentials (the Podcasts app's PodcastIndex key and secret)
.env

# Signing keys (NEVER commit private keys)
private.key
*_private.key
tools/*_private.key

# Rust build artifacts
components/kernel_rs/target/
recovery/target/

# Python bytecode
__pycache__/
*.py[cod]

# Claude Code
.claude/
simulator/build/
wasm/build/
# Local copy of the WASM simulator, so docs/index.html's "simulator/" link
# resolves when the docs are served from disk. CI builds this into _site.
docs/simulator/
.playwright-mcp/
appstore-site/
external/ghostty
crates/thistle-tk/target/

# The message history the simulator writes (msg_log.rs)
simulator/sdcard/messages/

# What the Podcasts app writes to the simulator's SD card: its library, saved
# episodes, and a PodcastIndex key and secret if set up from the app
simulator/sdcard/data/podcasts/
simulator/sdcard/podcasts/
simulator/sdcard/config/podcasts.json

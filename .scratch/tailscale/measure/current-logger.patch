+// MEASURE (test build only): appends "uptime_s,current_ma,millivolts" to
+// /sdcard/current.csv every 10 s, one row a second; negative is discharge.
+// uptime_s counts from the driver's start, so it restarts at each boot.
+fn measure_current_to_card() {
+    use std::io::Write;
+    let start = std::time::Instant::now();
+    let mut rows = String::new();
+    loop {
+        std::thread::sleep(std::time::Duration::from_millis(1000));
+        let (ma, mv) = {
+            let Ok(power) = POWER.lock() else { continue };
+            (
+                read_gauge(power.gauge, GAUGE_CMD_CURRENT).map(gauge_current_ma),
+                read_gauge(power.gauge, GAUGE_CMD_VOLTAGE).map(gauge_voltage_mv),
+            )
+        };
+        let uptime_s = start.elapsed().as_secs();
+        rows.push_str(&format!(
+            "{},{},{}\n",
+            uptime_s,
+            ma.map_or(String::new(), |v| v.to_string()),
+            mv.map_or(String::new(), |v| v.to_string())
+        ));
+        if rows.len() > 150 {
+            if let Ok(mut f) = std::fs::OpenOptions::new()
+                .create(true)
+                .append(true)
+                .open("/sdcard/current.csv")
+            {
+                let _ = f.write_all(rows.as_bytes());
+            }
+            rows.clear();
+        }
+    }
+}

# The Cohere API key the build gives dictation, read from the repository's
# .env, which git ignores, under the name the Hermes agent's .env uses:
#
#     COHERE_API_TOKEN=...
#
# thistle_dictation_credentials(<dir>) writes <dir>/dictation_key_default.h,
# defining DICTATION_DEFAULT_API_KEY when .env has the key, and nothing
# otherwise. <dir> must be in a build directory: the header holds the key,
# and nothing inside the source tree may. A card's config/dictation.json
# takes its place on a device (ui/dictation.h).
#
# The key is never printed. Editing .env reconfigures the build.

set(THISTLE_DICTATION_ENV "${CMAKE_CURRENT_LIST_DIR}/../../.env")

function(thistle_dictation_credentials out_dir)
    set(key "")
    get_filename_component(env_file "${THISTLE_DICTATION_ENV}" ABSOLUTE)
    if(EXISTS "${env_file}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${env_file}")
        file(STRINGS "${env_file}" lines)
        foreach(line IN LISTS lines)
            if(line MATCHES "^[ \t]*(export[ \t]+)?COHERE_API_TOKEN[ \t]*=[ \t]*[\"']?([^\"']*)[\"']?[ \t]*$")
                set(key "${CMAKE_MATCH_2}")
            endif()
        endforeach()
    endif()

    # Going into a C string as it is: printable ASCII, no quote or backslash,
    # which is all Cohere hands out.
    if(key MATCHES "[\"\\\\]" OR NOT key MATCHES "^[!-~]*$")
        message(WARNING "Dictation: .env's COHERE_API_TOKEN has a character it cannot use; "
                        "the build has no key, and a card's config/dictation.json must give one.")
        set(key "")
    endif()

    set(content "/* Generated by components/ui/dictation_credentials.cmake from .env: never commit. */\n#pragma once\n")
    if(key)
        string(APPEND content "#define DICTATION_DEFAULT_API_KEY \"${key}\"\n")
    endif()

    # Rewritten only when it changes, so a reconfigure rebuilds nothing.
    file(MAKE_DIRECTORY "${out_dir}")
    file(WRITE "${out_dir}/dictation_key_default.h.new" "${content}")
    configure_file("${out_dir}/dictation_key_default.h.new" "${out_dir}/dictation_key_default.h" COPYONLY)
    file(REMOVE "${out_dir}/dictation_key_default.h.new")
endfunction()

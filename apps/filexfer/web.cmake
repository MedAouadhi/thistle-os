# The File Transfer app's web page, web/index.html, as the bytes the server
# sends. thistle_filexfer_web(<dir>) writes <dir>/xfer_web_index.h, defining
# XFER_INDEX_HTML as the page's bytes and a closing NUL, for xfer_web.c.
# Editing the page reconfigures the build.

set(THISTLE_FILEXFER_PAGE "${CMAKE_CURRENT_LIST_DIR}/web/index.html")

function(thistle_filexfer_web out_dir)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${THISTLE_FILEXFER_PAGE}")
    file(READ "${THISTLE_FILEXFER_PAGE}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")

    set(content "/* Generated by apps/filexfer/web.cmake from web/index.html. */\n#pragma once\n")
    string(APPEND content "#define XFER_INDEX_HTML \\\n    ${bytes}0x00\n")

    # Rewritten only when it changes, so a reconfigure rebuilds nothing.
    file(MAKE_DIRECTORY "${out_dir}")
    file(WRITE "${out_dir}/xfer_web_index.h.new" "${content}")
    configure_file("${out_dir}/xfer_web_index.h.new" "${out_dir}/xfer_web_index.h" COPYONLY)
    file(REMOVE "${out_dir}/xfer_web_index.h.new")
endfunction()

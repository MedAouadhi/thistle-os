# The Hermes Device Bridge the build points the Hermes app at, read from the
# repository's .env, which git ignores:
#
#     HERMES_BRIDGE_URL=ws://100.125.204.43:8765
#
# It is no secret: the bridge reads no credential, and admits a device by its
# tailnet tag alone. It is the user's own address, though, so it stays out of
# the source tree like the keys beside it.
#
# thistle_hermes_bridge_url(<dir>) writes <dir>/hermes_url_default.h, defining
# HERMES_URL_DEFAULT when .env has one, and nothing otherwise. A card's
# config/hermes.json takes its place on a device (hermes_config.h). Editing
# .env reconfigures the build.

set(THISTLE_HERMES_ENV "${CMAKE_CURRENT_LIST_DIR}/../../.env")

function(thistle_hermes_bridge_url out_dir)
    set(url "")
    get_filename_component(env_file "${THISTLE_HERMES_ENV}" ABSOLUTE)
    if(EXISTS "${env_file}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${env_file}")
        file(STRINGS "${env_file}" lines)
        foreach(line IN LISTS lines)
            if(line MATCHES "^[ \t]*(export[ \t]+)?HERMES_BRIDGE_URL[ \t]*=[ \t]*\"?([^\"]*)\"?[ \t]*$")
                set(url "${CMAKE_MATCH_2}")
            endif()
        endforeach()
    endif()

    if(url MATCHES "[\"\\\\]" OR NOT url MATCHES "^[!-~]*$")
        message(WARNING "Hermes: .env's HERMES_BRIDGE_URL has a character it cannot use; "
                        "the app will ask for the address instead.")
        set(url "")
    endif()

    set(content "/* Generated by apps/hermes/bridge_url.cmake from .env: never commit. */\n#pragma once\n")
    if(url)
        string(APPEND content "#define HERMES_URL_DEFAULT \"${url}\"\n")
    endif()

    # Rewritten only when it changes, so a reconfigure rebuilds nothing.
    file(MAKE_DIRECTORY "${out_dir}")
    file(WRITE "${out_dir}/hermes_url_default.h.new" "${content}")
    configure_file("${out_dir}/hermes_url_default.h.new" "${out_dir}/hermes_url_default.h" COPYONLY)
    file(REMOVE "${out_dir}/hermes_url_default.h.new")
endfunction()

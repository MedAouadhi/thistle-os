# The PodcastIndex key and secret the build gives the Podcasts app, read from
# the repository's .env, which git ignores:
#
#     PODCASTINDEX_API_KEY=...
#     PODCASTINDEX_SECRET=...
#
# thistle_podcasts_credentials(<dir>) writes <dir>/pod_cred_default.h,
# defining POD_CRED_DEFAULT_KEY and POD_CRED_DEFAULT_SECRET when .env has
# both, and nothing otherwise. <dir> must be in a build directory: the header
# holds the secret, and nothing inside the source tree may. A card's
# config/podcasts.json takes their place on a device (pod_cred.h).
#
# Neither value is ever printed. Editing .env reconfigures the build.

set(THISTLE_PODCASTS_ENV "${CMAKE_CURRENT_LIST_DIR}/../../.env")

function(thistle_podcasts_credentials out_dir)
    set(key "")
    set(secret "")
    get_filename_component(env_file "${THISTLE_PODCASTS_ENV}" ABSOLUTE)
    if(EXISTS "${env_file}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${env_file}")
        file(STRINGS "${env_file}" lines)
        foreach(line IN LISTS lines)
            if(line MATCHES "^[ \t]*(export[ \t]+)?PODCASTINDEX_API_KEY[ \t]*=[ \t]*\"?([^\"]*)\"?[ \t]*$")
                set(key "${CMAKE_MATCH_2}")
            elseif(line MATCHES "^[ \t]*(export[ \t]+)?PODCASTINDEX_SECRET[ \t]*=[ \t]*\"?([^\"]*)\"?[ \t]*$")
                set(secret "${CMAKE_MATCH_2}")
            endif()
        endforeach()
    endif()

    # Going into a C string as they are: printable ASCII, no quote or
    # backslash, which is all PodcastIndex hands out.
    foreach(value IN ITEMS "${key}" "${secret}")
        if(value MATCHES "[\"\\\\]" OR NOT value MATCHES "^[!-~]*$")
            message(WARNING "Podcasts: .env's PodcastIndex key or secret has a character "
                            "it cannot use; the app will ask for them instead.")
            set(key "")
            set(secret "")
        endif()
    endforeach()

    set(content "/* Generated by apps/podcasts/credentials.cmake from .env: never commit. */\n#pragma once\n")
    if(key AND secret)
        string(APPEND content "#define POD_CRED_DEFAULT_KEY \"${key}\"\n")
        string(APPEND content "#define POD_CRED_DEFAULT_SECRET \"${secret}\"\n")
    endif()

    # Rewritten only when it changes, so a reconfigure rebuilds nothing.
    file(MAKE_DIRECTORY "${out_dir}")
    file(WRITE "${out_dir}/pod_cred_default.h.new" "${content}")
    configure_file("${out_dir}/pod_cred_default.h.new" "${out_dir}/pod_cred_default.h" COPYONLY)
    file(REMOVE "${out_dir}/pod_cred_default.h.new")
endfunction()

# Flash (16MB)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Compiler optimization for size (critical — we have 10+ apps)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3072

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# SD Card (SDMMC)
CONFIG_SOC_SDMMC_HOST_SUPPORTED=y

# Long filenames on the SD card. ESP-IDF's default is 8.3 only: FatFs then
# rejects a name like themes/night-instrument.json and reads every name back in
# capitals, so Reader found no ".txt" books on a card that had them.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Watchdog
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Keep newly installed OTA images rollback-eligible until app_main confirms
# the post-initialization health milestone.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# LVGL fonts (enable sizes used by ThistleOS UI)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_22=y

# Right-to-left text, for books in Arabic. Text with no right-to-left letter is
# laid out as before. LV_USE_ARABIC_PERSIAN_CHARS stays off: the Reader joins
# Arabic letters itself (apps/reader/reader/arabic_shape.c says why).
CONFIG_LV_USE_BIDI=y

# PPP for cellular data (required by drv_modem_a7682e esp_modem backend)
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
# Keepalive between the SoC and the modem (it never goes on air), so a modem
# that resets under a data session ends the session instead of hanging it.
CONFIG_LWIP_ENABLE_LCP_ECHO=y
# WiFi and the cellular link are up together; esp_netif routes over the one
# with the higher priority (WiFi). Without this, DNS servers are global and
# belong to whichever link connected last: the carrier's resolvers, often
# unreachable from WiFi, or the router's, unreachable from the carrier.
CONFIG_ESP_NETIF_SET_DNS_PER_DEFAULT_NETIF=y

# Uncomment to run ThistleOS unit tests on boot instead of normal boot sequence
# CONFIG_THISTLE_RUN_TESTS=y

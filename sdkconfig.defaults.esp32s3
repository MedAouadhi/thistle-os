# ESP32-S3 target defaults
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# S3 boards use external PSRAM. QUAD mode is the known-good ESP-IDF v5.5 mode.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# Internal RAM is what runs out: task stacks, DMA and anything used while the
# flash cache is off must be there, and it is about 330 KB in all, against
# 8 MB of PSRAM. So the big buffers that need none of that go to PSRAM: the
# WiFi and lwIP buffers, TLS sessions (about 40 KB each), the NimBLE host's
# pools and NVS's page cache.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# That makes WiFi's TX buffers static, and with the RX ones they take internal
# RAM for DMA, about 1.6 KB each, from the start: the defaults it brings, 16
# and 16, took 35 KB more than WiFi had used. A frame that finds no TX buffer
# waits in a queue in PSRAM (ESP_WIFI_CACHE_TX_BUFFER_NUM).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y
# Code placed in internal RAM for speed takes from the same memory. These run
# from flash instead: WiFi a little slower, and the BLE controller, which is
# off unless Bluetooth is switched on in Settings, can drop a connection while
# flash is erased.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
CONFIG_BT_NIMBLE_SM_LVL=4

# The Tailscale client (MicroLink, components/kernel/src/tailnet_platform.c).
# The control plane speaks Noise with ChaCha20-Poly1305, which mbedTLS
# leaves out unless asked.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
# MicroLink's own HTTP configuration server stays off: it would serve the
# auth key to the tailnet, and it is the only way to point the client at a
# control plane other than Tailscale's. Its build-time credentials are
# pinned empty, because a key compiled in is a key in every copy of the
# image; pairing is by a sign-in URL (tailnet_manager.rs).
CONFIG_ML_ENABLE_CONFIG_HTTPD=n
CONFIG_ML_TAILSCALE_AUTH_KEY=""
CONFIG_ML_WIFI_SSID=""
CONFIG_ML_WIFI_PASSWORD=""
CONFIG_ML_DEVICE_NAME=""
# The network coordinator owns WiFi and the modem; the client's own
# switching between them stays off.
CONFIG_ML_ENABLE_CELLULAR=n
# The control plane's map of the tailnet arrives in one buffer and is parsed
# in another, both in PSRAM: 512 KB each by default, for tailnets of hundreds.
# 128 KB holds about 80 peers.
CONFIG_ML_H2_BUFFER_SIZE_KB=128
CONFIG_ML_JSON_BUFFER_SIZE_KB=128
# Peers are cached in NVS, 92 bytes each, and NVS is 24 KB, shared with WiFi.
CONFIG_ML_NVS_MAX_PEERS=32
# getaddrinfo() asks the tailnet first, so "homelab" reaches a peer by name.
CONFIG_LWIP_HOOK_NETCONN_EXT_RESOLVE_CUSTOM=y
# The client times a TCP connect to each DERP region, about 30 a start, and
# closes each with a reset (SO_LINGER 0), so none waits two minutes in
# TIME_WAIT holding a PCB.
CONFIG_LWIP_SO_LINGER=y
# The client holds up to six sockets of its own (control, DERP, and STUN and
# disco over IPv4 and IPv6), on top of the File Transfer server's and any
# app's.
CONFIG_LWIP_MAX_SOCKETS=16

        },
        {
            "id": "com.thistle.drv.audio-es8311",
            "hal": "audio",
            "entry": "audio-es8311.drv.elf",
            "config": {
                "i2c_bus": 0,
                "i2c_addr": "0x18",
                "i2s_num": 0,
                "i2s_mclk": 38,
                "i2s_bck": 39,
                "i2s_ws": 18,
                "i2s_data": 40,
                "i2s_din": 17,
                "amp_expander": 0,
                "amp_expander_pin": 6,
                "voice_route_expander": 0,
                "voice_route_expander_pin": 10,
                "voice_route_level": 1
            }
        },
        {
            "id": "com.thistle.drv.sdcard",
            "hal": "storage",
            "entry": "sdcard.drv.elf",
            "config": {
                "spi_bus": 0,
                "pin_cs": 48,
                "mount_point": "/sdcard"
            }
        },
        {
            "id": "com.thistle.drv.modem-a7682e",
            "hal": "network",
            "entry": "modem-a7682e.drv.elf",
            "config": {
                "uart_num": 1,
                "tx": 10,
                "rx": 11,
                "baud_rate": 115200,
                "fast_baud_rate": 921600,
                "dtr": 8,
                "ri": 7,
                "power_expander": 0,
                "power_expander_pin": 0,
                "pwrkey_expander": 0,
                "pwrkey_expander_pin": 8,
                "pwrkey_press_level": 1
            }
        },
        {
            "id": "com.thistle.drv.haptic-drv2605",
            "hal": "haptic",
            "entry": "haptic-drv2605.drv.elf",
            "config": {
                "i2c_bus": 0,
                "i2c_addr": "0x5A",
                "en_expander": 0,
                "en_expander_pin": 5
            }
        }
    ]

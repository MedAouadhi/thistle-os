{
    "board": {
        "name": "LilyGo T-Deck Pro Max",
        "arch": "esp32s3",
        "board_id": "tdeck-max",
        "version": "1.0"
    },
    "buses": {
        "spi": [
            {
                "host": 2,
                "mosi": 33,
                "miso": 47,
                "sclk": 36,
                "max_transfer_bytes": 9600
            }
        ],
        "i2c": [
            {
                "port": 0,
                "sda": 13,
                "scl": 14,
                "freq_hz": 400000
            }
        ]
    },
    "io_expanders": [
        {
            "id": "com.thistle.drv.ioexp-xl9555",
            "i2c_bus": 0,
            "i2c_addr": "0x20"
        }
    ],
    "expander_outputs": [
        {"expander": 0, "pin": 2, "direction": "output", "level": 1, "delay_ms": 10},
        {"expander": 0, "pin": 1, "direction": "output", "level": 1, "delay_ms": 10},
        {"expander": 0, "pin": 3, "direction": "output", "level": 1, "delay_ms": 10},
        {"expander": 0, "pin": 7, "direction": "output", "level": 0, "delay_ms": 10},
        {"expander": 0, "pin": 9, "direction": "output", "level": 0, "delay_ms": 10},
        {"expander": 0, "pin": 7, "direction": "output", "level": 1, "delay_ms": 50},
        {"expander": 0, "pin": 9, "direction": "output", "level": 1, "delay_ms": 50},
        {"expander": 0, "pin": 6, "direction": "output", "level": 0, "delay_ms": 0},
        {"expander": 0, "pin": 10, "direction": "output", "level": 0, "delay_ms": 0}
    ],
    "radio_antenna_switch": {"expander": 0, "pin": 4, "internal_level": 1},
    "power": {
        "key": {"gpio": 0, "active_level": 0},
        "wake": [
            {"source": "keyboard", "gpio": 15, "active_level": 0},
            {"source": "modem", "gpio": 7, "active_level": 0},
            {"source": "radio", "gpio": 5, "active_level": 1}
        ],
        "deep_sleep_off": [
            {"expander": 0, "pin": 1},
            {"expander": 0, "pin": 2},
            {"expander": 0, "pin": 3},
            {"expander": 0, "pin": 5},
            {"expander": 0, "pin": 6}
        ]
    },
    "drivers": [
        {
            "id": "com.thistle.drv.epaper-gdeq031t10",
            "hal": "display",
            "entry": "epaper-gdeq031t10.drv.elf",
            "config": {
                "spi_bus": 0,
                "cs": 34,
                "dc": 35,
                "rst": 9,
                "busy": 37,
                "bl": 41,
                "spi_clock_hz": 4000000,
                "rotation": 180
            }
        },
        {
            "id": "com.thistle.drv.kbd-tca8418",
            "hal": "input",
            "entry": "kbd-tca8418.drv.elf",
            "config": {
                "i2c_bus": 0,
                "i2c_addr": "0x34",
                "pin_int": 15,
                "pin_backlight": 42
            }
        },
        {
            "id": "com.thistle.drv.touch-cst66xx",
            "hal": "input",
            "entry": "touch-cst66xx.drv.elf",
            "config": {
                "i2c_bus": 0,
                "i2c_addr": "0x1A",
                "pin_int": 12,
                "pin_rst": -1,
                "rst_expander": 0,
                "rst_expander_pin": 7,
                "max_x": 240,
                "max_y": 320,
                "home_key": 0,
                "back_key": 2,
                "quick_key": 1
            }
        },
        {
            "id": "com.thistle.drv.gps-mia-m10q",
            "hal": "gps",
            "entry": "gps-mia-m10q.drv.elf",
            "config": {
                "uart_num": 2,
                "tx": 16,
                "rx": 2,
                "baud_rate": 38400
            }
        },
        {
            "id": "com.thistle.drv.radio-sx1262",
            "hal": "radio",
            "entry": "radio-sx1262.drv.elf",
            "config": {
                "spi_bus": 0,
                "cs": 3,
                "dio1": 5,
                "rst": 4,
                "busy": 6,
                "freq_hz": 868000000,
                "tcxo_mv": 2400,
                "dio2_rf_switch": true
            }
        },
        {
            "id": "com.thistle.drv.imu-bhi260ap",
            "hal": "imu",
            "entry": "imu-bhi260ap.drv.elf",
            "config": {
                "i2c_bus": 0,
                "i2c_addr": "0x28",
                "pin_int": 21
            }
        },
        {
            "id": "com.thistle.drv.power-sy6970",
            "hal": "power",
            "entry": "power-sy6970.drv.elf",
            "config": {
                "i2c_bus": 0,
                "gauge_i2c_addr": "0x55",
                "battery_capacity_mah": 1400
